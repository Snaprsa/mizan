# Local development placeholders. Never put real credentials in this example.
DATABASE_URL=sqlite+aiosqlite:///./storage/mizan.db
DATABASE_URL_SYNC=sqlite:///./storage/mizan.db
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=dev-secret-change-in-production-immediately
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
ANTHROPIC_API_KEY=
AQARSAS_EMAIL=
AQARSAS_PASSWORD=
PASEETAH_EMAIL=
PASEETAH_PASSWORD=
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_URL=http://127.0.0.1:3100
API_URL=http://127.0.0.1:8000
ENV=development
DEBUG=false

# Map imagery: add the free Esri key in the app (map icon). It is stored in the macOS Keychain.
# Hosts without a Keychain can set it for the API server only. Never use a NEXT_PUBLIC_ variable for it:
# MIZAN_ARCGIS_API_KEY=
