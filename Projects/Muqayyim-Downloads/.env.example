# Local development placeholders. Never put real credentials in this example.
DATABASE_URL=sqlite+aiosqlite:///./storage/mizan.db
DATABASE_URL_SYNC=sqlite:///./storage/mizan.db
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=dev-secret-change-in-production-immediately
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
ANTHROPIC_API_KEY=
AQARSAS_EMAIL=
AQARSAS_PASSWORD=
PASEETAH_EMAIL=
PASEETAH_PASSWORD=
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_URL=http://127.0.0.1:3100
API_URL=http://127.0.0.1:8000
ENV=development
DEBUG=false

# Map imagery (frontend, build-time). Put these in frontend/.env.local, then rebuild the frontend.
# NEXT_PUBLIC_MAP_PROVIDER=google
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=   # restricted browser key: HTTP referrers + Maps JavaScript API (+ Geocoding API for address search)
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=    # optional; a vector Map ID enables rotation/tilt where Google supports it
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png   # road-map fallback only
