# Qaim Environment Variables
# Copy to .env and adjust for your environment

# ── Database ──
DATABASE_URL=postgresql+asyncpg://qaim:qaim_dev@localhost:5432/qaim
DATABASE_URL_SYNC=postgresql://qaim:qaim_dev@localhost:5432/qaim

# ── Redis ──
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── File Storage ──
UPLOAD_DIR=/tmp/qaim_uploads
EXPORT_DIR=/tmp/qaim_exports

# ── Auth ──
SECRET_KEY=qaim-dev-secret-change-in-prod

# ── Frontend ──
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
