# Free imagery: Esri ArcGIS Location Platform free tier (no payment method required).
NEXT_PUBLIC_ARCGIS_API_KEY=YOUR_FREE_ARCGIS_LOCATION_PLATFORM_KEY
# Fallback road map (no satellite), used when no key is set:
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
